{
  "name": "@duplocode/governance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed run governance: admission, RunState transitions, and evidence-driven publication. Attestation signing remains a control-plane concern.",
  "exports": "./dist/index.js",
